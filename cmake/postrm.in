#!/bin/bash
# postrm script for encosmotordriver

set -e

case "$1" in
    remove|purge|disappear)
        # Ensure critical system directories exist after package removal
        # dpkg may remove them if they become empty
        CRITICAL_DIRS=(
            "/usr/local/include"
            "/usr/local/lib"
            "/usr/local/bin"
        )
        
        for dir in "${CRITICAL_DIRS[@]}"; do
            if [ ! -d "$dir" ]; then
                mkdir -p "$dir"
                echo "Restored system directory: $dir"
            fi
        done
        ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade)
        ;;
    
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
