
@PACKAGE_INIT@

set(ENCOS_ENABLE_SPDLOG @ENCOS_ENABLE_SPDLOG@)
set(ENCOS_PLUGIN_INSTALL_DIR "${PACKAGE_PREFIX_DIR}/@ENCOS_PLUGIN_INSTALL_LIBDIR@")

include(CMakeFindDependencyMacro)
if(ENCOS_ENABLE_SPDLOG)
    find_dependency(spdlog REQUIRED)
    find_dependency(fmt REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/encos_driverTargets.cmake")

# 为源码树写法提供兼容别名，使外部插件 CMakeLists 可以链接非命名空间目标
if(TARGET Encos::encos_driver AND NOT TARGET EncosMotorDriver)
    add_library(EncosMotorDriver ALIAS Encos::encos_driver)
endif()
if(TARGET Encos::encos_driver_base AND NOT TARGET EncosMotorDriverBase)
    add_library(EncosMotorDriverBase ALIAS Encos::encos_driver_base)
endif()
if(TARGET Encos::encos_driver AND NOT TARGET Encos::EncosMotorDriver)
    add_library(Encos::EncosMotorDriver ALIAS Encos::encos_driver)
endif()
if(TARGET Encos::encos_driver_base AND NOT TARGET Encos::EncosMotorDriverBase)
    add_library(Encos::EncosMotorDriverBase ALIAS Encos::encos_driver_base)
endif()

# 加载插件注册 API；模块内部通过全局属性进入安装消费分支
set_property(GLOBAL PROPERTY _ENCOS_INSTALLED_PACKAGE_MODE TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/EncosPlugins.cmake")
