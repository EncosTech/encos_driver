set(_install_manifest "@CMAKE_INSTALL_PREFIX@/install_manifest.txt")
if(NOT EXISTS "${_install_manifest}")
  # fallback to manifest located next to this script (common when running from build dir)
  set(_alt "${CMAKE_CURRENT_LIST_DIR}/install_manifest.txt")
  if(EXISTS "${_alt}")
    set(_install_manifest "${_alt}")
  else()
    message(FATAL_ERROR "Cannot find install manifest: @CMAKE_INSTALL_PREFIX@/install_manifest.txt or ${_alt}")
  endif()
endif()

file(READ "${_install_manifest}" files)
string(REGEX REPLACE "\n" ";" files "${files}")

# Track directories for cleanup
set(_dirs_to_check "")

foreach(file ${files})
  if(file)
    message(STATUS "Removing: ${file}")
    if(EXISTS "${file}")
      # Collect parent directory for later cleanup
      get_filename_component(_dir "${file}" DIRECTORY)
      list(APPEND _dirs_to_check "${_dir}")
      
      file(REMOVE "${file}")
      if(EXISTS "${file}")
        message(WARNING "Failed to remove ${file}")
      else()
        message(STATUS "  Removed successfully")
      endif()
    else()
      message(STATUS "  File not found (already removed)")
    endif()
  endif()
endforeach()

# Remove empty directories (from deepest to shallowest)
# Protected system directories that should never be removed
set(_protected_dirs 
  "/usr"
  "/usr/local"
  "/usr/local/lib"
  "/usr/local/include"
  "/usr/local/bin"
  "/usr/lib"
  "/usr/include"
  "/usr/bin"
  "@CMAKE_INSTALL_PREFIX@"
)

if(_dirs_to_check)
  list(REMOVE_DUPLICATES _dirs_to_check)
  # Sort by path depth (longest paths first)
  list(SORT _dirs_to_check COMPARE STRING ORDER DESCENDING)
  
  foreach(_dir ${_dirs_to_check})
    # Skip protected system directories
    list(FIND _protected_dirs "${_dir}" _is_protected)
    if(_is_protected GREATER -1)
      continue()
    endif()
    
    if(EXISTS "${_dir}")
      file(GLOB _dir_contents "${_dir}/*")
      list(FILTER _dir_contents EXCLUDE REGEX "/.git$")
      if(NOT _dir_contents)
        message(STATUS "Removing empty directory: ${_dir}")
        file(REMOVE_RECURSE "${_dir}")
      endif()
    endif()
  endforeach()
endif()

if(EXISTS "@CMAKE_INSTALL_PREFIX@/install_manifest.txt")
  file(REMOVE "@CMAKE_INSTALL_PREFIX@/install_manifest.txt")
  message(STATUS "Removed install manifest")
endif()

# If we created an encos_install_record.txt, use it to revert rc changes and remove symlinks
if(EXISTS "@CMAKE_INSTALL_PREFIX@/encos_install_record.txt")
  file(READ "@CMAKE_INSTALL_PREFIX@/encos_install_record.txt" _rec)
  string(REGEX REPLACE "\n$" "" _rec "${_rec}")
  separate_arguments(_lines UNIX_COMMAND "${_rec}")
  foreach(line ${_lines})
    string(SUBSTRING ${line} 0 3 _tag)
    if(_tag STREQUAL "RC:")
      string(SUBSTRING ${line} 3 -1 _rcfile)
      if(EXISTS "${_rcfile}")
        file(READ "${_rcfile}" _content)
        string(REGEX REPLACE "(?m)^.*EncosMotorDriver plugin path.*\n?" "" _content "${_content}")
        string(REGEX REPLACE "(?m)^.*ENCOS_PLUGIN_PATH=.*\n?" "" _content "${_content}")
        file(WRITE "${_rcfile}" "${_content}")
        message(STATUS "Edited ${_rcfile} to remove ENCOS_PLUGIN_PATH entries")
      endif()
    elseif(_tag STREQUAL "SYM")
      # format SYM:/path
      string(SUBSTRING ${line} 4 -1 _sympath)
      if(EXISTS "${_sympath}")
        file(REMOVE "${_sympath}")
        message(STATUS "Removed symlink ${_sympath}")
      endif()
    endif()
  endforeach()
  file(REMOVE "@CMAKE_INSTALL_PREFIX@/encos_install_record.txt")
  message(STATUS "Removed install record")
endif()
