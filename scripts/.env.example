# 凭证：只通过环境变量传递给发布脚本。
GITEA_USERNAME=
GITEA_TOKEN=
GH_TOKEN=

# 源代码仓库与分支。版本号只从 MAIN_BRANCH 提取。
SOURCE_REPO=https://git.in.encos.cn/bismarckkk/motor_driver.git
MAIN_BRANCH=main
OPTIONAL_BRANCHES=

# GitHub 镜像仓库。
GITHUB_RELEASE_REPOSITORY=
GITHUB_RELEASE_REPOSITORY_URL=

# Gitea Debian 软件包仓库。
GITEA_URL=https://git.in.encos.cn
GITEA_PACKAGE_OWNER=packages
DEBIAN_DISTRIBUTIONS=jammy,noble
DEBIAN_ARCHITECTURES=amd64,arm64
DEBIAN_COMPONENT=main

# 可选配置。
GIT_USER_NAME=Encos Release Bot
GIT_USER_EMAIL=release-bot@encos.cn
GITHUB_API_URL=https://api.github.com
GITHUB_UPLOAD_URL=https://uploads.github.com
